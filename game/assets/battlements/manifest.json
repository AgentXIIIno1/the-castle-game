    "batt_floor.png": {
      "cell": [
        16,
        16
      ],
      "variants": 6,
      "rule": "variant = thash(x,y) % 6 (existing floor_tiles hook)",
      "content": "weathered flagstone walkway, two slabs per tile, lichen, hairline cracks; v4 rain puddle reflecting the dusk sky, v5 grass in a crack"
    },
    "batt_post.png": {
      "frame_size": [
        18,
        38
      ],
      "frames": 2,
      "frame_use": "0 = show_face (post above floor), 1 = no face (wall below; bottom 14px transparent)",
      "anchor": "top-left at art3.pillar's (X, Y) = (x*16-1, y*16+TOP-RAISE-8): same 18px width, T top block and 8(+FACE) face as pillar()",
      "content": "squat turret merlon with a 3-merlon crenellated cap, arrow loop on the face, lichen"
    },
    "stairs_{up,down}_battlement_{1x1,2x1,1x2,2x2}.png": {
      "layout": "identical to art/stairs (same drawers, sizes and tiling; the 2x2 tiling rule of art3.draw_stairs applies)",
      "palette": "weathered outdoor stone + lichen"
    },
    "underlay_<rid>.png": {
      "size": [
        384,
        312
      ],
      "blit_at": [
        0,
        0
      ],
      "covers_floor_from_col": null,
      "content": "dusk view far below (fields, hedgerows, woods, a river, a road, hamlets; half resolution + depth haze toward the top like balcony_view), the curtain wall's outer face dropping into the haze under every wall cell that faces the void to the south (starts 6px under the cell below the wall, i.e. under the 14px front face), soft shadow along walls bordering the void",
      "note": "drawn first in bake_room like balcony_view; walls, floors, posts, stairs go over it. With it, no bake pixel stays magenta, so the outline stencil hides nothing in these rooms (the view replaces the void)"
    }
  },
